# Copy into Vercel → Project → Settings → Environment Variables (Production), then redeploy.
# NEXT_PUBLIC_* is baked in at `next build`.
#
# Root Directory in Vercel must be `cineprompt-ai`. Monorepo root `.env.production` is not used by Next.
#
# Razorpay: no secrets on Vercel. Set RAZORPAY_* on the API (cinePrompt-api/.env.production.example).
# Razorpay webhook (API only, not Vercel): https://api.datacaptain.in/v1/payment/webhook
# Checkout mode (test vs live) follows the API’s RAZORPAY_KEY_ID — use a staging API with test keys if needed.

NEXT_PUBLIC_API_BASE_URL=https://api.datacaptain.in/v1
NEXT_PUBLIC_GOOGLE_CLIENT_ID=343746941144-ucvr6cnrsi85fopbqjmsd7voc1ucgdig.apps.googleusercontent.com

# Optional: only if the public API origin differs from the URL above without /v1
# NEXT_PUBLIC_DATACAPTAIN_URL=https://api.datacaptain.in

# Maintenance mode — redirects most site traffic to /maintenance during deploys/outages
# MAINTENANCE_MODE=true
# NEXT_PUBLIC_MAINTENANCE_MESSAGE=We're rolling out a platform update. Back in a few minutes.
